# Copy to .env and adjust
APP_NAME=FashionRise API
ENVIRONMENT=development
DEBUG=true
TESTING=false

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://fashionrise:fashionrise@localhost:5432/fashionrise

# JWT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# CORS (comma-separated origins, or * for dev; never * in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Local file storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/storage
PUBLIC_UPLOAD_BASE_URL=http://localhost:8000/static/uploads

# Static mount path (must be under LOCAL_STORAGE_ROOT for local backend)
UPLOAD_SUBDIR=uploads

# Upload limits (image/jpeg, image/png, image/webp enforced + magic-byte check)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_IMAGE_TYPES=image/jpeg,image/png,image/webp
