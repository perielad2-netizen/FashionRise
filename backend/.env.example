# Copy to .env and adjust
APP_NAME=FashionRise API
ENVIRONMENT=development
DEBUG=true
TESTING=false

# Log every SQL statement to stderr when true (very noisy with the AI worker; use only for SQL debugging).
SQLALCHEMY_ECHO=false

# PostgreSQL (SQLAlchemy URL). App and Alembic both read backend/.env — use the same DB for `alembic upgrade head` and uvicorn.
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/fashionrise

# Required for pytest / disposable Alembic smoke. Must be an explicit non-production DB
# (name contains test|qa|mig). Never point at fashionrise_beta or DATABASE_URL.
# DATABASE_URL_TEST=postgresql+psycopg2://postgres:123456@localhost:5432/fashionrise_test

# JWT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# CORS (comma-separated origins, or * for dev; never * in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Invite-only beta registration. Keep false until an approved deploy enables it.
# Even when true, every signup still requires a single-use email-bound invitation.
REGISTRATION_ENABLED=false

# When true, rate limiting keys on X-Real-IP from a trusted reverse proxy that
# overwrites the header with $remote_addr. Leave false unless Nginx does that.
TRUST_PROXY_HEADERS=false

# Origin Cloudflare Access JWT gate for FastAPI /api/** only (not Nginx static HTML).
# Keep false until a separately approved deployment. When true, TEAM_DOMAIN + AUD
# are required or the API process refuses to start (fail closed).
# TEAM_DOMAIN must be exactly https://<team>.cloudflareaccess.com (no path).
# AUD is the Access Application Audience tag from Zero Trust → Applications.
CF_ACCESS_JWT_VALIDATION=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional seamless FashionRise login from verified Access JWT (existing users only).
# Requires TEAM_DOMAIN + AUD. Never auto-provisions accounts. Default off.
# Prefer Google OAuth below; leave CF Access SSO off when Access is removed.
CF_ACCESS_SSO_LOGIN=false

# Google Sign-In (Gmail). When all three are set, /auth/google/* is enabled.
# Create OAuth client in Google Cloud Console → APIs & Services → Credentials
# (Web application). Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://fashionrise.app/api/v1/auth/google/callback
PUBLIC_APP_URL=https://fashionrise.app
# Auto-create FashionRise users on first Google sign-in (no invitation).
GOOGLE_OAUTH_AUTO_REGISTER=true

# AI Stars wallet — new profiles start with 10; first Magic free when magic=10.
AI_STARS_STARTING_BALANCE=10
AI_STARS_MAGIC_COST=10
AI_STARS_CROQUIS_COST=10
AI_STARS_PDF_COST=50
AI_STARS_FABRIC_COST=5
# Comma-separated emails with endless Stars (never debit).
AI_STARS_UNLIMITED_EMAILS=perielad@gmail.com,perielad2@gmail.com
# Opt-in finite-wallet override for purchase testing (wins over unlimited list + DB flag).
# Empty by default. Does not change is_admin.
# Example for TestFlight purchase testing: AI_STARS_FINITE_OVERRIDE_EMAILS=perielad2@gmail.com
# Clear an email here to restore that account's unlimited Stars.
AI_STARS_FINITE_OVERRIDE_EMAILS=
# Keep false until payment provider is wired.
STARS_SHOP_CHECKOUT_ENABLED=false

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Local file storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/storage
PUBLIC_UPLOAD_BASE_URL=http://127.0.0.1:8001/static/uploads

# Static mount path (must be under LOCAL_STORAGE_ROOT for local backend)
UPLOAD_SUBDIR=uploads
# Private bytes (never under /static/uploads)
PRIVATE_FABRIC_SUBDIR=private_fabrics
PRIVATE_TECHPACK_SUBDIR=private_techpacks
# Create Real Design optional AI draft assist — keep false (0 paid calls by default)
TECHPACK_AI_DRAFT_ENABLED=false

# Upload limits (image/jpeg, image/png, image/webp enforced + magic-byte check)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI job worker: API embeds a loop when AI_WORKER_ENABLED=true. For split deploy, set false on API and run:
#   cd backend && python -m app.ai_worker
# Optional: python -m app.ai_worker --once  (single batch, good for cron)
AI_WORKER_ENABLED=true
AI_WORKER_POLL_INTERVAL_SECONDS=1.5
AI_WORKER_BATCH_SIZE=12

# OpenAI — when OPENAI_API_KEY is set, sketch_clean / sketch_polish / style_suggest jobs use
# Chat Completions vision + JSON. Default model is gpt-6-luna (replacement for deprecated gpt-4o-mini).
# Put your real key only in backend/.env (never commit it). Leave empty here and in .env for stub results.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max — none is for gpt-6-luna (and gpt-6-sol).
# gpt-6-astra / gpt-6.1-sol reject none. gpt-4o-mini omits the field.
OPENAI_REASONING_EFFORT=none
# Visible JSON token budget (not shared with hidden reasoning when effort=none).
OPENAI_MAX_COMPLETION_TOKENS=1400
# Optional: Azure OpenAI or compatible proxy (e.g. https://example.openai.azure.com/openai/v1)
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=180
OPENAI_HTTP_TIMEOUT_SECONDS=60
# sketch_polish also generates a shareable look image via images.edit (sketch-faithful).
# Prefer gpt-image-2.5-sunburst (gpt-image-1 shut down 2026-10-23). Set off to disable.
# Quality: high (FashionRise default). Legacy "standard" is accepted in code and maps to high.
# Do not set xhigh/max — those fail closed before any paid images.edit.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# Web Push (Runway likes/scores/comments). Empty = disabled.
# Generate: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key.decode() if isinstance(v.public_key,bytes) else v.public_key); print(v.private_key.decode() if isinstance(v.private_key,bytes) else v.private_key)"
# Or: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@fashionrise.app

# Store IAP (App Store / Play Store). Confirm fail-closed until configured + enabled.
# Apple Phase A verifies StoreKit 2 JWS via App Store Server Library (not shared secret).
IAP_APPLE_SHARED_SECRET=
IAP_APPLE_BUNDLE_ID=app.fashionrise.studio
IAP_APPLE_APP_APPLE_ID=6832116469
# Both default OFF until Phase B. purchasing = new StoreKit buys; credit = confirm/reconcile.
IAP_APPLE_PURCHASING_ENABLED=false
IAP_APPLE_CREDIT_ENABLED=false
# Comma-separated FashionRise emails allowed to Buy/confirm while public gates stay OFF.
# Keep empty for public-off. Example: owner@example.com
IAP_APPLE_SANDBOX_TESTER_EMAILS=
IAP_APPLE_ONLINE_CHECKS=true
# App Store Server API (ASC In-App Purchase key). Outbound only — not required for inbound ASN verify.
# Store the .p8 outside the repo (e.g. /var/lib/fashionrise/secrets/apple-iap/AuthKey_<KEYID>.p8).
IAP_APPLE_ASC_ISSUER_ID=
IAP_APPLE_ASC_KEY_ID=
IAP_APPLE_ASC_PRIVATE_KEY_PATH=
IAP_GOOGLE_SERVICE_ACCOUNT_JSON=
# Forced off in production. Apple Phase A also refuses unverified credits in non-prod.
IAP_ALLOW_UNVERIFIED_SANDBOX=false
