# FashionRise API — production (copy to /opt/fashionrise/backend/.env and chmod 600)
# Never commit the real .env file.

APP_NAME=FashionRise API
ENVIRONMENT=production
DEBUG=false
TESTING=false

# SQLAlchemy (use a strong password; DB user should not be superuser)
DATABASE_URL=postgresql+psycopg2://fashionrise:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/fashionrise

# libpq-style vars (optional; used by deploy/backup_postgres.sh and restore)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=fashionrise
PGDATABASE=fashionrise
# PGPASSWORD=same_as_in_DATABASE_URL

# JWT — generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_64_PLUS_RANDOM_CHARS_MINIMUM_32_REQUIRED
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# Comma-separated HTTPS origins (no spaces). Never use * in production.
CORS_ORIGINS=https://app.example.com,https://www.example.com

# Google Sign-In (Gmail). When all three are set, /auth/google/* is enabled.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://fashionrise.app/api/v1/auth/google/callback
# PUBLIC_APP_URL=https://fashionrise.app
# GOOGLE_OAUTH_AUTO_REGISTER=true
# Keep CF Access SSO/JWT off when Access is removed from fashionrise.app:
# CF_ACCESS_SSO_LOGIN=false
# CF_ACCESS_JWT_VALIDATION=false

# Logging
LOG_LEVEL=INFO

# Uploads
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/var/lib/fashionrise/storage
PUBLIC_UPLOAD_BASE_URL=https://api.example.com/static/uploads
UPLOAD_SUBDIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI jobs: set AI_WORKER_ENABLED=false on API if you run a separate systemd unit: python -m app.ai_worker
AI_WORKER_ENABLED=true
AI_WORKER_POLL_INTERVAL_SECONDS=1.5
AI_WORKER_BATCH_SIZE=12

# Optional OpenAI sketch pipeline (never commit the real key). Empty key keeps the stub worker.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# OPENAI_MAX_COMPLETION_TOKENS=1400
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=high
# OPENAI_IMAGE_SIZE=1024x1536

# FASHN Virtual Try-On (optional specialist path; OpenAI try-on remains default)
# FASHN_API_KEY=
# FASHN_TRY_ON_ENABLED=false
# FASHN_TRY_ON_LIVE_HTTP=false
# FASHN_TRY_ON_ESTIMATE_CENTS=8
# FASHN_API_BASE_URL=https://api.fashn.ai
# FASHN_POLL_INTERVAL_SECONDS=2
# FASHN_POLL_TIMEOUT_SECONDS=120
# Owner-only Try-On Max experiment (#173). Empty allowlist = nobody.
# FASHN_TRY_ON_MAX_ENABLED=false
# FASHN_TRY_ON_MAX_LIVE_HTTP=false
# FASHN_TRY_ON_MAX_OWNER_ALLOWLIST=
# FASHN_TRY_ON_MAX_SOFT_BUDGET_CREDITS=90
