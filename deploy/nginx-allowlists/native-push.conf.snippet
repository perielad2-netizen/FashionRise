# FashionRise — Native Push nginx allowlist (version-controlled source of truth)
#
# Required in production sites-available/fashionrise.app ABOVE:
#   location /api/ { return 403; }
#
# Apply / verify:
#   deploy/nginx-allowlists/assert_native_push_allowlist.sh /etc/nginx/sites-available/fashionrise.app
#   # or merge this snippet next to capability / web-push blocks, then:
#   nginx -t && systemctl reload nginx
#
# Do NOT regenerate production from deploy/nginx_fashionrise.conf (legacy open
# proxy stub). Production uses an explicit per-route allowlist.

    # Native push capability probe (Capacitor / Android)
    location = /api/v1/push/native/capability {
        limit_except GET OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Native push device registration (FCM/APNs)
    # Missing this block → OPTIONS/POST nginx 403 for Capacitor Origin https://localhost
    location = /api/v1/push/native/devices {
        limit_except GET POST DELETE OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }
