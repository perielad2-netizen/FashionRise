# FastAPI base URL (include /api/v1). Local operator default from FashionRise docs.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Frontend registration UX only (Create Account link + /register route).
# Default off. Backend REGISTRATION_ENABLED remains the authoritative signup gate.
# Set true only during the separately approved WEB-V3B activation window.
# VITE_REGISTRATION_UI_ENABLED=false

# Frontend Magic UX only (Studio Magic button + Your Look panel).
# Default off. Production also keeps Nginx AI routes denied until approved.
# VITE_MAGIC_UI_ENABLED=false

# Front/Back Studio (dual-side draft v2 + Flip + rear croquis).
# Default off. Production Front/Back release sets this true separately.
# VITE_STUDIO_FRONT_BACK_ENABLED=false

# Dual Magic (Front+Back polish / polish-dual). Default off.
# Keep false while Front/Back drawing ships without Dual Magic backend.
# Front-only Magic remains governed by VITE_MAGIC_UI_ENABLED alone.
# VITE_STUDIO_DUAL_MAGIC_ENABLED=false

# Create My Croquis wizard visibility (Stage B). Default off.
# Independent of FRONT_BACK / MAGIC / DUAL. Backend upload/AI gates also default false.
# VITE_MY_CROQUIS_UI_ENABLED=false
# Approved notice bodies required before consent can be recorded (empty = fail closed).
# VITE_MY_CROQUIS_ADULTS_NOTICE_TEXT=
# VITE_MY_CROQUIS_STORAGE_NOTICE_TEXT=
# VITE_MY_CROQUIS_AI_NOTICE_TEXT=

