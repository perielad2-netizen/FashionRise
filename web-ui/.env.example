# FastAPI base URL (include /api/v1). Local operator default from FashionRise docs.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Frontend registration UX only (Create Account link + /register route).
# Default off. Backend REGISTRATION_ENABLED remains the authoritative signup gate.
# Set true only during the separately approved WEB-V3B activation window.
# VITE_REGISTRATION_UI_ENABLED=false

