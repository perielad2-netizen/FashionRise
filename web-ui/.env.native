# Used by `npm run build:native` for App Store / Play Store shells.
# Absolute API — Capacitor loads file:// or capacitor:// assets, so /api/v1 will not resolve.
VITE_API_BASE_URL=https://fashionrise.app/api/v1
VITE_REGISTRATION_UI_ENABLED=false
VITE_MAGIC_UI_ENABLED=true
VITE_STUDIO_FRONT_BACK_ENABLED=true
VITE_STUDIO_DUAL_MAGIC_ENABLED=true
# Show My Models on Home + drawer in App Store / TestFlight builds.
VITE_MY_CROQUIS_UI_ENABLED=true
VITE_PUBLIC_APP_URL=https://fashionrise.app
VITE_SOCIAL_INSTAGRAM=fashionrise
VITE_SOCIAL_TIKTOK=fashionrise
VITE_NATIVE_SHELL=true
