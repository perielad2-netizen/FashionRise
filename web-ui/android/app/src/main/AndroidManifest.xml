<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google OAuth return: Custom Tabs → app.fashionrise.studio://auth/google/native -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="app.fashionrise.studio"
                    android:host="auth"
                    android:pathPrefix="/google" />
            </intent-filter>

            <!-- App Links (https://fashionrise.app) — requires live assetlinks.json + SHA-256.
                 Until verified, links open in the browser; deepLinks still handle appUrlOpen. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/studio" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/login" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/register" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/forgot-password" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/reset-password" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/verify-email" />
                <data android:scheme="https" android:host="fashionrise.app" android:pathPrefix="/privacy" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/studio" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/login" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/register" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/forgot-password" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/reset-password" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/verify-email" />
                <data android:scheme="https" android:host="www.fashionrise.app" android:pathPrefix="/privacy" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ notification permission (requested at runtime after auth). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
